{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OWNER/hone/main/catalog.schema.json",
  "title": "Hone skill catalog",
  "description": "Machine-readable index of the skills in this pack, generated by scripts/validate-skills.mjs --write.",
  "type": "object",
  "required": ["version", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "license", "path", "headings", "references"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Kebab-case identifier; must match the directory name."
          },
          "description": {
            "type": "string",
            "minLength": 60,
            "maxLength": 600,
            "description": "The trigger sentence an agent matches against."
          },
          "license": { "type": "string", "description": "SPDX identifier." },
          "path": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$",
            "description": "Path to the skill file, relative to the repository root."
          },
          "headings": {
            "type": "integer",
            "minimum": 4,
            "description": "Number of level-2 headings in the skill body."
          },
          "references": {
            "type": "array",
            "items": { "type": "string", "pattern": "\\.md$" },
            "description": "Files in the skill's references/ directory, linked from SKILL.md."
          }
        }
      }
    }
  }
}
